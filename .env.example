# ==============================================================================
# ANTI-RAGGING PORTAL - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the actual values.
# DO NOT COMMIT .env OR ANY REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# ── Flask Core ─────────────────────────────────────────────────────────────────
# A random, persistent secret string (min 32 chars). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-random-secret-key-min-32-chars

# 'development' or 'production'
FLASK_ENV=development

# Set to True in production to enforce HTTPS-only cookies
SESSION_COOKIE_SECURE=False

# Session type: 'filesystem' (default, development) or 'sqlalchemy' (production)
SESSION_TYPE=filesystem

# ── Database ───────────────────────────────────────────────────────────────────
# Leave unset (or blank) to use the local SQLite development database.
#
# Supabase PostgreSQL (Session Pooler – port 6543):
#   DATABASE_URL=postgresql://[db-user]:[password]@[host]:6543/postgres
#
# Supabase PostgreSQL (Direct connection – port 5432):
#   DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
#
# The application auto-prefixes the psycopg3 driver and adds sslmode=require
# for remote hosts. You do NOT need to add these manually.
#
# DO NOT hard-code a real password here. Set DATABASE_URL only in your shell
# environment or Render/Railway/Heroku config vars, never in this file.
#DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Connection pool settings (PostgreSQL only — ignored for SQLite)
#DB_POOL_SIZE=10
#DB_MAX_OVERFLOW=5
#DB_POOL_RECYCLE_SECONDS=300

# ── Supabase Storage (optional – for evidence file storage in production) ──────
# Required only if STORAGE_BACKEND=supabase
#STORAGE_BACKEND=local
#SUPABASE_URL=https://[project-ref].supabase.co
#SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
#SUPABASE_STORAGE_BUCKET=evidence

# ── Administrator ──────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@velhightech.com
ADMIN_PASSWORD=your_secure_admin_password

# ── SMTP Email (for OTP delivery and status updates) ──────────────────────────
# For Gmail: Use your Gmail address and a 16-character Google App Password.
# Do NOT use your personal Google account password.
# To generate a Google App Password:
#   1. Enable 2-Step Verification on your Google Account:
#      https://myaccount.google.com/security
#   2. Navigate to "App passwords" (search for it in the account search bar).
#   3. Create a new App Password for "Anti-Ragging Portal" or "Mail".
#   4. Paste the 16-character code below as SMTP_PASSWORD.
SMTP_EMAIL=your_smtp_sender@domain.com
SMTP_PASSWORD=your_16_character_app_password
# Aliases accepted for backwards compatibility:
# EMAIL_USER=your_smtp_sender@domain.com
# EMAIL_PASS=your_16_character_app_password

# SMTP Server Connection Settings
# Default: smtp.gmail.com on port 587 (STARTTLS) or port 465 (SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Set to True if using port 465 (SSL) or False for port 587 (STARTTLS)
SMTP_USE_SSL=False
SMTP_USE_TLS=True
SMTP_TIMEOUT=15

# Local Development / Offline Testing:
# Set to True to print OTP codes directly to application logs instead of sending real emails.
DEV_SIMULATE_EMAIL=False

# ── Twilio SMS / Voice (optional – simulated if unset) ────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Evidence Upload ────────────────────────────────────────────────────────────
# Maximum allowed size in bytes for a single upload (default: 25 MB)
MAX_UPLOAD_SIZE_BYTES=26214400

# ── Notification Scheduler ─────────────────────────────────────────────────────
# Hours before an Open complaint triggers an admin reminder (default: 24)
REMINDER_OPEN_HOURS=24
# Hours before an In-Progress complaint triggers a follow-up reminder (default: 72)
REMINDER_IN_PROGRESS_HOURS=72
# Seconds between reminder checks (default: 3600 = 1 hour)
REMINDER_CHECK_INTERVAL_SECONDS=3600

# Set to 'true' to disable the background reminder scheduler (e.g., for testing
# or when using a dedicated background worker instead of gunicorn threads)
DISABLE_REMINDER_SCHEDULER=False

# ── Deployment / Advanced ──────────────────────────────────────────────────────
# Set to 'true' to skip the in-app schema migration/verification on startup.
# Only enable this if you are managing schema exclusively through Alembic.
#SKIP_SCHEMA_INIT=false
